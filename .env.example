# Бэкенд
CATALOG_DB_PATH=catalog.db
# ИИ-сервис: claude (основной) или gemini (запасной)
AI_PROVIDER=claude
# Ключ Claude API: https://console.anthropic.com → API Keys (нужен пополненный баланс)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 — дёшево; claude-sonnet-5-5 — сильнее и дороже
CLAUDE_MODEL=claude-haiku-5-5
# Запасной Gemini, нужен только при AI_PROVIDER=gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CORS_ORIGINS=http://localhost:5173
# Превью-деплои Vercel (адрес меняется с веткой). Пример: https://styleit-ai-[a-z0-9-]+-styleit1\.vercel\.app
CORS_ORIGIN_REGEX=
FREE_CAPSULES_PER_DAY=5
RATE_LIMIT=30/minute

# Фронтенд
VITE_API_URL=http://localhost:8000
